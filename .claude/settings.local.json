{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(make)",
      "PowerShell(make all*)",
      "PowerShell(make build-x86*)",
      "PowerShell(make build-x64*)",
      "PowerShell(make test*)",
      "PowerShell(make clean*)",
      "PowerShell(cl.exe *)",
      "PowerShell(cl *)",
      "PowerShell(rc.exe *)",
      "PowerShell(rc *)",
      "PowerShell(link.exe *)",
      "PowerShell(link *)",
      "PowerShell(dumpbin.exe *)",
      "PowerShell(dumpbin *)",
      "PowerShell(vcpkg install *)",
      "PowerShell(vcpkg list*)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git describe)",
      "PowerShell(git describe *)",
      "PowerShell(git rev-list *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git switch -c stage/*)",
      "PowerShell(git switch -c chore/*)",
      "PowerShell(git switch -c fix/*)",
      "PowerShell(git switch -c docs/*)",
      "PowerShell(git switch main)",
      "PowerShell(git pull --ff-only)",
      "PowerShell(git push -u origin stage/*)",
      "PowerShell(git push -u origin chore/*)",
      "PowerShell(git push -u origin fix/*)",
      "PowerShell(git push -u origin docs/*)",
      "PowerShell(git push origin stage/*)",
      "PowerShell(git push origin chore/*)",
      "PowerShell(git push origin fix/*)",
      "PowerShell(git push origin docs/*)",
      "PowerShell(git fetch *)",
      "PowerShell(git branch *)",
      "PowerShell(git ls-files *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Select-String *)",
      "PowerShell(dir *)",
      "PowerShell(ls *)"
    ],
    "deny": [
      "PowerShell(git tag *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git branch -D *)",
      "PowerShell(rm -rf *)",
      "PowerShell(del /f /s /q *)",
      "PowerShell(rmdir /s /q *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(git push)",
      "PowerShell(git push origin main*)",
      "PowerShell(git push * main*)",
      "PowerShell(git push * HEAD:main*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * --tags*)",
      "PowerShell(git push * --delete*)",
      "PowerShell(git push * :*)"
    ]
  }
}
