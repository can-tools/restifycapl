// version.rc -- restifycapl (CAPL REST DLL)
//
// No version number is ever hand-edited in this file. VER_MAJOR, VER_MINOR,
// VER_BUILD, VER_REV and VER_STRING are supplied by the Makefile via
// `rc.exe /D ...` (see msvc-build-conventions skill and the "Versioning"
// section of Makefile). The #ifndef fallbacks below exist only so a bare
// `rc.exe version.rc` (no /D flags) still compiles -- they are not a second
// place version numbers live; the Makefile's derivation from the Git tag /
// commit count is the single source of truth.
//
// FILEVERSION/PRODUCTVERSION are four 16-bit fields (major,minor,build,
// revision), each capped at 65535 -- they wrap silently if fed anything
// larger, so only small integers are ever passed in here. VER_STRING is
// free text (not numerically constrained) and carries the full
// `git describe --tags --always --dirty` output for the human-readable
// FileVersion/ProductVersion strings.

#ifndef VER_MAJOR
#define VER_MAJOR 0
#endif
#ifndef VER_MINOR
#define VER_MINOR 0
#endif
#ifndef VER_BUILD
#define VER_BUILD 0
#endif
#ifndef VER_REV
#define VER_REV 0
#endif
#ifndef VER_STRING
#define VER_STRING "0.0.0.0-dev"
#endif

#include <winresrc.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_MAJOR,VER_MINOR,VER_BUILD,VER_REV
 PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_BUILD,VER_REV
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L        // VOS_NT_WINDOWS32
 FILETYPE 0x2L          // VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "restifycapl project"
            VALUE "FileDescription",  "CAPL REST DLL -- REST/HTTP and JSON support for CAPL scripts in Vector CANoe"
            VALUE "FileVersion",      VER_STRING
            VALUE "InternalName",     "restifycapl"
            VALUE "OriginalFilename", "restifycapl.dll"
            VALUE "ProductName",      "restifycapl"
            VALUE "ProductVersion",   VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
