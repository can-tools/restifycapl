long restLibRequestSync(char method[], char url[], char requestHeaders[], char requestBody[], char responseBody[], dword connectTimeoutMs, dword totalTimeoutMs, dword maxResponseBytes, long &httpStatusCode, dword &responseBodyLength)
{
  return restifyRequestSync(method, elcount(method), url, elcount(url), requestHeaders, elcount(requestHeaders), requestBody, elcount(requestBody), responseBody, elcount(responseBody), connectTimeoutMs, totalTimeoutMs, maxResponseBytes, httpStatusCode, responseBodyLength);
}
